# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TELEGRAM_BOT_TOKEN: Bot API token obtained from @BotFather
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"

# TELEGRAM_CHANNEL_ID: Target Telegram channel username or ID (e.g. @everydaypsych or -1001234567890)
TELEGRAM_CHANNEL_ID="@your_psychology_channel"

# APP_URL: The URL where this applet is hosted (optional in CI/CD).
APP_URL="MY_APP_URL"
